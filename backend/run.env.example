# Vorlage für den lokalen Backend-Start aus der IDE (oder ./gradlew bootRun).
#
# Kopieren nach backend/run.env und bei Bedarf anpassen:
#     cp backend/run.env.example backend/run.env
#
# backend/run.env ist NICHT versioniert. Das dev-Profil lädt die Datei über
# spring.config.import (siehe src/main/resources/application-dev.properties).
# Voraussetzung: Run-Konfiguration mit aktivem Profil "dev" und Arbeits-
# verzeichnis "backend/". Alle Pfade sind relativ zu "backend/".
#
# Vorbereitung einmalig:
#   scripts/database_create_secrets.sh          # secrets/ + docker/backup/status
#   backend/scripts/backend_generate_rsa_keys.sh
#   docker compose -f docker/docker-compose-dev.yml up -d   # db auf localhost:3306

# --- Datenbank (Container aus docker-compose-dev.yml, Port 3306 veröffentlicht) ---
MYSQL_HOST=localhost
MYSQL_DATABASE=openfls
MYSQL_USER_FILE=../secrets/db_user.secret
MYSQL_PASSWORD_FILE=../secrets/db_password.secret

# --- JWT-Schlüssel (von backend_generate_rsa_keys.sh erzeugt) ---
JWT_PRIVATE_KEY=file:../secrets/jwt_private_key.secret
JWT_PUBLIC_KEY=file:../secrets/jwt_public_key.secret

# --- Sitzungsdauer in Sekunden ---
SESSION_TIMEOUT=6000

# --- Nur-Lese-Backup-Dashboard: Statusverzeichnis des Backup-Containers ---
BACKUP_STATUS_MOUNT=../docker/backup/status
BACKUP_MAX_AGE_HOURS=7

# --- Logverzeichnis ---
LOG_DIR=./logs

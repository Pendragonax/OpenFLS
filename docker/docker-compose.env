MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password
MYSQL_PASSWORD_FILE=/run/secrets/db_password
MYSQL_USER_FILE=/run/secrets/db_user
MYSQL_DATABASE=openfls
MYSQL_HOST=open_fls_db
MYSQL_PORT=3306
MYSQL_BACKUP_USER=openfls_backup
MYSQL_BACKUP_PASSWORD_FILE=/run/secrets/db_backup_password
BACKUP_DIR=/backup
BACKUP_STATUS_DIR=/backup/status
BACKUP_RETENTION_DAYS=14
BACKUP_HISTORY_MAX_ENTRIES=100
# Backup zur festen Uhrzeit (HH:MM, 24h) in dieser Zeitzone.
BACKUP_TIME=02:30
# Gueltige Werte: IANA-Zonennamen wie Europe/Berlin oder UTC. Vollstaendige Liste
# im Container unter /usr/share/zoneinfo bzw.
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones (Spalte "TZ identifier").
BACKUP_TIMEZONE=Europe/Berlin
# Abstand in ganzen Tagen zwischen zwei Backups: 1 = taeglich, 2 = alle 48 h, ...
# Werte < 1 werden als 1 behandelt.
BACKUP_INTERVAL_DAYS=1
BACKUP_RETRY_INTERVAL_SECONDS=300
BACKUP_STALE_LOCK_SECONDS=43200
BACKUP_MAX_AGE_HOURS=26
SESSION_TIMEOUT=36000
USERNAME=vinz

BACKUP_HISTORY_MAX_ENTRIES=100
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETRY_INTERVAL_SECONDS=30
BACKUP_STALE_LOCK_SECONDS=43200
BACKUP_MAX_AGE_HOURS=7
SESSION_TIMEOUT=36000
